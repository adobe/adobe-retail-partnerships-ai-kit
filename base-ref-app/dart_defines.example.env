# Copy this file to `dart_defines.env` (gitignored).
# Then run:  flutter run --dart-define-from-file=dart_defines.env
#
# The app talks only to the BFF — no IMS token or client_id here.
# (Run the BFF separately: see bff/README.md. Credentials live in bff/.env.)

# Base URL of the BFF.
#   web / iOS simulator : http://localhost:8080
#   Android emulator    : http://10.0.2.2:8080
BFF_BASE_URL=http://localhost:8080

# Adobe-integration dart-defines (e.g. an offer id) are added by the Partner
# Integration AI Kit when the integration is generated onto this base app.
