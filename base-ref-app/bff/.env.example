# Partner Ref App — BFF configuration (feature-less base app).
# Copy to .env (gitignored) and fill in values. NEVER commit .env.
#
# Nothing below is required to just run the app: JWT_SECRET is
# auto-generated per-run if left blank, and the partner store falls back to an
# in-memory store seeded with a demo partner (EXAMPLE-001) if MONGODB_URL is
# unset. Fill these in once you want stability across restarts or real
# persistence (e.g. while implementing/testing a feature).
#
# This base app carries NO Adobe integration config. The Partner
# Integration AI Kit adds the Adobe variables (IMS credentials, Retail API base
# URL, offer id, Notify secret) when the integration is generated onto this app.

# Port the BFF listens on
PORT=8080

# JWT signing secret. Auto-generated per-run if unset. To set a stable one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MongoDB connection URI, for persistent partner data. Local example:
#   mongodb://localhost:27017/partner_ref_app
# If unset, falls back to an in-memory store seeded with a demo partner.
MONGODB_URL=

# Comma-separated allowed CORS origins, or * for any (dev only)
CORS_ORIGINS=*

# Comma-separated client-ids allowed to call the /admin/* partner-management routes.
REFAPP_ADMIN_ALLOWED_CLIENT_IDS=

# Partner login. With MONGODB_URL set, partners are stored in MongoDB —
# provision rows directly or via POST /admin/partners (no startup seeding).
# userId format <PARTNER>-<number> (e.g. EXAMPLE-001); the prefix selects the
# partner record.
